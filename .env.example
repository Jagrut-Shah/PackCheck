# =============================================================================
# PackCheck AI - Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real secret credentials to version control.
# =============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase Configuration (Database, Auth, Storage) - Owner: Vijay
# -----------------------------------------------------------------------------
# Public client credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only service role (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# Python OCR Microservice - Owner: Arwa
# -----------------------------------------------------------------------------
# Internal endpoint for PaddleOCR FastAPI microservice
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_API_KEY=your-internal-ocr-api-key

# -----------------------------------------------------------------------------
# AI Extraction & Rules Engine - Owner: Member 3
# -----------------------------------------------------------------------------
# LLM Provider Key for structured Legal Metrology Rule 6 extraction
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Verification Report Service - Owner: Team Lead
# -----------------------------------------------------------------------------
# Secret key used for HMAC/cryptographic signing of PDF audit reports
REPORT_SIGNING_SECRET=your-report-cryptographic-secret
