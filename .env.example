# =============================================================================
# PackCheck AI - Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real secret credentials to version control.
# =============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase Configuration (Database, Auth, Storage)
# -----------------------------------------------------------------------------
# Public client credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Python OCR Microservice (PaddleOCR FastAPI)
# -----------------------------------------------------------------------------
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# AI Extraction & Rules Engine (LLM Provider)
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Verification Report Service
# -----------------------------------------------------------------------------
REPORT_SIGNING_SECRET=
