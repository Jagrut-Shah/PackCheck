# ==============================================================================
# PackCheck AI - Environment Configuration Template
# Copy this file to .env.local for local development.
# In production (Vercel / Cloud Run), configure these in your secrets manager.
# DO NOT commit .env.local or any real secrets to Git.
# ==============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PaddleOCR Microservice Configuration (Server-Only)
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_API_KEY=your-cryptographically-secure-ocr-internal-secret

# Google Gemini 3.8 Flash (Server-Only, SIH Demo Free Tier - NO BILLING)
GEMINI_API_KEY=your-gemini-api-key

# Cryptographic Report Signing Secret (Server-Only, Never NEXT_PUBLIC_)
# Must be a cryptographically secure random string used for HMAC-SHA256
# digital signing and Section 65B Indian Evidence Act admissibility verification.
REPORT_SIGNING_SECRET=your-cryptographically-strong-report-signing-secret
